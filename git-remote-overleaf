#!/usr/bin/env python3
"""git-remote-overleaf — a git remote (pull + push) backed by an Overleaf instance.

Makes `git clone overleaf::<project>` / `git fetch` / `git pull` / `git push`
work like a normal remote: the helper checks the Overleaf change list, downloads only the
NEW versions (history API, not rate-limited; the first fetch replays the
whole history), builds one commit per Overleaf change in a local cache mirror
(~/.cache/overleaf-fakegit/<project-id>/ by default), turns labels into
overleaf/* tags, and serves it all through native git upload-pack. Progress is
shown as "remote:" lines.

`git push` (main only, fast-forward only) runs git receive-pack on the cache
mirror; its pre-receive hook (fakegit.py pre-receive) uploads the changed
files to Overleaf and deletes removed ones before the ref moves.

Config (resolved in this order):
  git config overleaf.url          instance base URL
  env OVERLEAF_URL
  overleaf-fakegit/config.json     (tool folder)
  https://overleaf.ktu.edu.tr      (fallback)
  git config overleaf.cookie-file  cookie file path
  env OVERLEAF_COOKIE
  cookie.txt in the project dir / next to this script

Cache location: git config overleaf.cache-dir | env OVERLEAF_CACHE_DIR |
$XDG_CACHE_HOME/overleaf-fakegit | ~/.cache/overleaf-fakegit
"""

import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fakegit  # noqa: E402  (auto re-execs into the .venv if needed)

DEBUG_LOG = os.environ.get("OVERLEAF_DEBUG_LOG")
CONNECTING = False   # stdout becomes the native git protocol during connect


def _log(*args):
    """Timestamped debug log to a file (stdout is the git protocol channel)."""
    if not DEBUG_LOG:
        return
    try:
        with open(DEBUG_LOG, "a") as f:
            f.write(f"[{time.strftime('%H:%M:%S')}] "
                    + " ".join(str(a) for a in args) + "\n")
    except Exception:
        pass


def _info(msg):
    if CONNECTING:
        print(msg, file=sys.stderr, flush=True)   # stdout is the pack protocol
    else:
        print(f"info {msg}", flush=True)


def _git_env():
    """Env for git subprocess calls that target the cache mirror — the helper
    inherits GIT_DIR from the invoking repo, which would override -C."""
    return {k: v for k, v in os.environ.items()
            if k not in ("GIT_DIR", "GIT_WORK_TREE")}


def _git_config(key):
    try:
        out = subprocess.run(["git", "config", "--get", key],
                             capture_output=True, text=True, timeout=5,
                             env=_git_env())
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return None


def _resolve_cfg(spec):
    """Instance URL, project id, cookie, and cache dir for the URL spec."""
    cfg, cookie = fakegit.remote_cfg(spec, _git_config)
    project = cfg["project"]
    cache = (_git_config("overleaf.cache-dir")
             or os.environ.get("OVERLEAF_CACHE_DIR")
             or os.environ.get("XDG_CACHE_HOME")
             or os.path.expanduser("~/.cache"))
    return cfg, cookie, os.path.join(cache, "overleaf-fakegit", project)


def _write_alternates(git_dir, mirror_objects):
    """Point the requesting repo's object store at the cache mirror."""
    try:
        info_dir = os.path.join(git_dir, "objects", "info")
        os.makedirs(info_dir, exist_ok=True)
        alt_path = os.path.join(info_dir, "alternates")
        existing = []
        if os.path.exists(alt_path):
            with open(alt_path) as f:
                existing = f.read().splitlines()
        if mirror_objects not in existing:
            with open(alt_path, "a") as f:
                if existing:
                    f.write("\n")
                f.write(mirror_objects + "\n")
    except OSError as e:
        _info(f"warning: could not set up object alternates: {e}")


def _mirror_tip(mirror):
    import pygit2
    repo = pygit2.Repository(mirror)
    if repo.head_is_unborn:
        return None
    return str(repo.head.target)


class _InfoWriter:
    """stdout replacement that relays complete lines live as progress."""
    def __init__(self):
        self.buf = ""

    def write(self, text):
        self.buf += text
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            if line.strip():
                _info(line)
        return len(text)

    def flush(self):
        pass


def _sync(cfg, cookie, cache_dir):
    """Bring the cache mirror up to date: every new Overleaf version becomes a
    commit (history API — not rate-limited; the first fetch replays the whole
    history), labels become tags. Falls back to a snapshot of the latest
    version if the change list is unavailable."""
    import contextlib
    fakegit.create_mirror(cache_dir)
    _log("sync start")
    with contextlib.redirect_stdout(_InfoWriter()):
        repo = fakegit.open_mirror(cache_dir)
        state = fakegit.load_state(cache_dir)
        known = state.get("last_toV") or fakegit.mirror_tip_toV(repo)
        try:
            updates = fakegit.fetch_all_updates(cfg, cookie, after_toV=known)
        except fakegit.AuthError:
            raise
        except fakegit.FgError as e:
            _log("sync: updates API failed: ", e)
            print(f"change list unavailable ({e}); serving a snapshot.")
            _, h = fakegit.snapshot_latest(cache_dir, cfg, cookie, None)
            if h:
                state["last_content_hash"] = h
                fakegit.save_state(cache_dir, state)
            return "snapshot"
        if updates:
            print(f"replaying {len(updates)} Overleaf version(s) as commits"
                  + (" (full history, first fetch)…" if known is None else "…"))
            fakegit.replay_history(cache_dir, cfg, cookie, updates)
            state = fakegit.load_state(cache_dir)
            state["last_toV"] = updates[-1]["toV"]
            fakegit.save_state(cache_dir, state)
        fakegit.sync_labels(cache_dir, cfg, cookie)
    _log("sync done: last_toV=", fakegit.load_state(cache_dir).get("last_toV"))
    return "synced" if updates else "no changes"


def _import_objects(git_dir, mirror):
    """Write the cache mirror's objects into the requesting repo via
    fast-import (private ref namespace). git 2.55's clone creates the real
    refs itself (REF_TRANSACTION_FLAG_INITIAL), so we must not pre-create
    refs/remotes/origin/*."""
    _log("import objects into", git_dir)
    p = subprocess.run(
        ["git", "-C", mirror, "fast-export", "--signed-tags=strip",
         "--refspec=refs/heads/main:refs/import/overleaf/main",
         "refs/heads/main"],
        capture_output=True, timeout=300, env=_git_env())
    if p.returncode != 0:
        raise RuntimeError(f"fast-export failed: "
                           f"{p.stderr[:200].decode('utf-8', 'replace')}")
    # drop the trailing 'reset'/'from' lines (commit lines already create refs)
    lines = p.stdout.split(b"\n")
    out = []
    i = 0
    while i < len(lines):
        if lines[i].startswith(b"reset "):
            i += 1
            if i < len(lines) and lines[i].startswith(b"from "):
                i += 1
            continue
        out.append(lines[i])
        i += 1
    stream = b"\n".join(out) + b"done\n"
    fi = subprocess.run(["git", "--git-dir=" + git_dir, "fast-import",
                         "--quiet"],
                        input=stream, capture_output=True, timeout=300,
                        env=_git_env())
    if fi.returncode != 0:
        raise RuntimeError(f"fast-import failed: "
                           f"{fi.stderr[:300].decode('utf-8', 'replace')}")


def main():
    # git invokes the helper as: git-remote-overleaf <remote-name> <url>
    spec = sys.argv[2] if len(sys.argv) > 2 else (sys.argv[1] if len(sys.argv) > 1 else "")
    git_dir = os.environ.get("GIT_DIR")
    _log("start", "argv=", sys.argv, "GIT_DIR=", git_dir)
    try:
        cfg, cookie, cache_dir = _resolve_cfg(spec)
    except fakegit.FgError as e:
        _info(f"error: {e}")
        return 1
    _log("cfg: url=", cfg["url"], "project=", cfg["project"],
         "cache_dir=", cache_dir, "cookie_len=", len(cookie))
    os.makedirs(cache_dir, exist_ok=True)
    mirror = fakegit.mirror_path(cache_dir)
    if git_dir:
        _write_alternates(git_dir, os.path.join(mirror, "objects"))
    synced = False
    imported_objects = False
    pending_fetches = []

    while True:
        line = sys.stdin.readline()
        if not line:
            _log("stdin EOF")
            break
        cmd = line.strip()
        if not cmd:
            # blank line ends a fetch batch: respond with oks + a blank line
            if pending_fetches:
                _log("fetch batch:", pending_fetches)
                if git_dir and not imported_objects:
                    try:
                        _import_objects(git_dir, mirror)
                        imported_objects = True
                    except Exception as e:      # noqa: BLE001
                        _log("import objects failed:", e)
                        for fcmd in pending_fetches:
                            print(f"error {fcmd.split()[1]} {e}")
                        pending_fetches = []
                        print()
                        sys.stdout.flush()
                        continue
                for fcmd in pending_fetches:
                    parts = fcmd.split()
                    name = parts[2] if len(parts) > 2 else parts[1]
                    _log("ok", name)
                print()                         # end the response batch
                sys.stdout.flush()
                pending_fetches = []
            continue
        _log("->", repr(cmd))
        if cmd == "capabilities":
            print("connect")
            print("fetch")
            print("refspec refs/heads/*:refs/remotes/origin/*")
            print()
        elif cmd.startswith("option "):
            print("ok")
        elif cmd.startswith("connect"):
            # native git protocol: sync the mirror, then run git upload-pack
            # with the helper's stdin/stdout — real pack negotiation, only new
            # objects transferred (vs re-serializing the whole history)
            _log("connect:", cmd)
            global CONNECTING
            CONNECTING = True
            if not synced:
                try:
                    _sync(cfg, cookie, cache_dir)
                except fakegit.AuthError as e:
                    _info(f"error: {e}")
                    return 1
                except Exception as e:      # noqa: BLE001
                    _info(f"sync failed: {e}")
                synced = True
            service = cmd.split()[1] if len(cmd.split()) > 1 else ""
            env = _git_env()
            if service == "git-receive-pack":
                # push: receive-pack on the cache mirror; its pre-receive hook
                # uploads the change to Overleaf before the ref moves
                fakegit.save_config(cache_dir, cfg)
                fakegit.install_push_hook(cache_dir)
                env["OVERLEAF_COOKIE"] = cookie
            elif service != "git-upload-pack":
                print(f"error: unsupported service {service}", file=sys.stderr)
                return 1
            print()                         # empty line = connection established
            sys.stdout.flush()
            p = subprocess.Popen(["git", service[len("git-"):], mirror],
                                 stdin=sys.stdin.fileno(),
                                 stdout=sys.stdout.fileno(),
                                 stderr=sys.stderr, env=env)
            p.wait()
            _log("connect ended")
            return 0                        # helper exits after the connection
        elif cmd == "list":
            if not synced:
                try:
                    _sync(cfg, cookie, cache_dir)
                except fakegit.AuthError as e:
                    _info(f"error: {e}")
                    return 1
                except Exception as e:      # noqa: BLE001 — keep the protocol alive
                    _info(f"sync failed: {e}")
                synced = True
            tip = _mirror_tip(mirror)
            _log("list tip=", tip)
            if tip:
                print(f"{tip} refs/heads/main")
                print("@refs/heads/main HEAD")   # symbolic HEAD -> the branch
            print()
        elif cmd.startswith("fetch "):
            pending_fetches.append(cmd)
        elif cmd == "exit":
            break
        else:
            print(f"error {cmd} unsupported command")
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
